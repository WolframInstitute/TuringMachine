Cell[CellGroupData[{

Cell[TextData[{
 "Basic Description",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"LongDescription", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Give a short paragraph explaining your paclet. This is the first \
text that users will see when visiting the main landing page of your paclet.",
          "MoreInfoText"], Background -> GrayLevel[0.95], FrameMargins -> 20, 
        FrameStyle -> GrayLevel[0.9], RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoLongDescription"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "bde87481-8830-4b20-b171-545056684222"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "LongDescription"},
 DefaultNewCellStyle->"Text",
 CellTags->{"Basic Description", "LongDescription", "TemplateCellGroup"},
 CellID->97826971,ExpressionUUID->"8aa696c8-5bf8-4e00-83b6-5207158a7925"],

Cell[TextData[{
 "The paclet identifies a Turing machine by its enumeration number and its ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s", ",", " ", "k"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36249aa0-8cf6-4239-bac3-0f8950245433"],
 " state/color counts. ",
 Cell[BoxData[
  ButtonBox["OneSidedTuringMachineFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/OneSidedTuringMachineFunction"]\
], "InlineFormula",ExpressionUUID->"7d3e8f4b-f9fa-4585-9def-9cc9fffdf2b9"],
 " runs a one-sided machine on an integer input and returns its halting \
value, step count, or tape width; ",
 Cell[BoxData[
  ButtonBox["OneSidedTuringMachinePlot",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/OneSidedTuringMachinePlot"]], 
  "InlineFormula",ExpressionUUID->"976a23da-a0bf-4281-987a-aa535f6a7a99"],
 " draws the space-time evolution; and ",
 Cell[BoxData[
  ButtonBox["OneSidedTuringMachineFind",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/OneSidedTuringMachineFind"]], 
  "InlineFormula",ExpressionUUID->"ae0dc45f-f7a6-4d78-b3ab-f524775702fa"],
 " searches for machines reproducing given outputs. The ",
 Cell[BoxData[
  ButtonBox["MultiwayTuringMachineFunction",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/MultiwayTuringMachineFunction"]\
], "InlineFormula",ExpressionUUID->"dcfc2c81-a215-49cb-9d20-e1af1df4af4b"],
 " family explores nondeterministic (multiway) machines, while ",
 Cell[BoxData[
  ButtonBox["TuringMachineRuleCount",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/TuringMachineRuleCount"]], 
  "InlineFormula",ExpressionUUID->"4e0b79ae-f6f0-4b3b-a1f6-d21ecc193a60"],
 " and the ",
 Cell[BoxData[
  ButtonBox["TuringMachineOutput",
   BaseStyle->"Link",
   ButtonData->
    "paclet:WolframInstitute/TuringMachine/ref/TuringMachineOutput"]], 
  "InlineFormula",ExpressionUUID->"4f654845-66e1-4a5c-916a-b892cb09b773"],
 " primitives tabulate behavior across whole rule spaces."
}], "Text",ExpressionUUID->"6788fd21-785a-4ac6-8990-b3854d11f153"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Details may include a long description of the resource's contents, \
history, methodology or other relevant information. Give references here if \
they are directly relevant to the resource. The details will appear above the \
examples on the webpage for the resource.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetails"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "230c101d-937c-4f37-a9b6-39761c1a2289"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"66748fc7-0092-453c-bf27-1dfb314b13b3"],

Cell[TextData[{
 "A Turing machine is specified by its Wolfram enumeration number together \
with its state and color counts, written ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"number", ",", " ", "s", ",", " ", "k"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "048f8836-3b61-4492-a3b0-fadd74cb8126"],
 " \[LongDash] for example ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"600720", ",", " ", "3", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37e816c5-7f4c-49f9-938c-ce52c674dbd8"],
 " is rule 600720 with 3 states and 2 colors."
}], "Notes",ExpressionUUID->"bf775fa2-5cc5-47d9-8f00-5bb317344222"],

Cell["\<\
The one-sided functions read a non-negative integer input off the tape, run \
the machine, and report the halting value, the number of steps taken, or the \
maximum tape width reached.\
\>", "Notes",ExpressionUUID->"819e97ff-0c58-46aa-b2e0-e75d6d76e80f"],

Cell[TextData[{
 "A machine that does not halt within the given step bound reports ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2aaeeae-9f71-4439-b927-b114949d0133"],
 " / ",
 Cell[BoxData["Undefined"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b06e4eab-bfc0-4da7-af30-ce628662ff3f"],
 " for the parts it could not resolve."
}], "Notes",ExpressionUUID->"5e873913-e1aa-476b-a82a-4934197af5e9"],

Cell[TextData[{
 "The multiway functions explore nondeterministic machines, where a ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"state", ",", " ", "color"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f507072e-7721-4d9d-9b3e-951f3c66451e"],
 " pair may carry several transitions, and return all reachable \
configurations."
}], "Notes",ExpressionUUID->"000bc3cf-ccbe-4ccf-a117-30329c32dcea"],

Cell[TextData[{
 "A Rust backend (loaded from the paclet's ",
 Cell[BoxData["Binaries"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21213fb5-1368-47bf-8edf-13fb32b769f6"],
 ") accelerates the bulk enumeration and search functions over whole rule \
spaces."
}], "Notes",ExpressionUUID->"cee9752c-3ddb-4cfd-85fb-5bcde6bd0161"]
}, Open  ]],

