Cell[CellGroupData[{

Cell["Scope", "Subsection",ExpressionUUID->"0363fa0d-3681-4840-bd36-4657c7967d68"],

Cell[TextData[{
 "Evaluate a whole family of machines at once \[LongDash] every ",
 StyleBox["s", "TI"],
 "=1, ",
 StyleBox["k", "TI"],
 "=2 one-sided machine on inputs 1 through 8, each for up to 32 steps:"
