Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", "\n", "   ", 
    RowBox[{"evolution", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{"input", ",", "\n", "      ", 
       RowBox[{"OneSidedTuringMachinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"600720", ",", " ", "3", ",", " ", "2"}], "}"}], ",", " ", 
         "input", ",", " ", "16", ",", " ", 
         RowBox[{"\"\<LabelOutput\>\"", " ", "->", " ", "False"}]}], "]"}]}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ImageResize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Rasterize", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Framed", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", "\n", "       ", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<TuringMachine\>\"", ",", " ", "30", ",", " ", 
               "Bold", ",", " ", 
               RowBox[{"GrayLevel", "[", "0.15", "]"}], ",", " ", 
               RowBox[{
               "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
              "]"}], ",", "\n", "       ", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<Exploring and analyzing Turing machines\>\"", ",", 
               " ", "13", ",", " ", 
               RowBox[{"GrayLevel", "[", "0.45", "]"}], ",", " ", 
               RowBox[{
               "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}]}], 
              "]"}], ",", "\n", "       ", 
             RowBox[{"Spacer", "[", "14", "]"}], ",", "\n", "       ", 
             RowBox[{"Row", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"evolution", "[", "10", "]"}], ",", " ", 
                 RowBox[{"evolution", "[", "106", "]"}]}], "}"}], ",", " ", 
               RowBox[{"Spacer", "[", "24", "]"}]}], "]"}]}], "}"}], ",", 
           "\n", "      ", 
           RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
           RowBox[{"Spacings", " ", "->", " ", "1.0"}]}], "]"}], ",", "\n", 
         "    ", 
         RowBox[{"Background", " ", "->", " ", 
          RowBox[{"GrayLevel", "[", "0.98", "]"}]}], ",", " ", 
         RowBox[{"FrameMargins", " ", "->", " ", "30"}], ",", " ", 
         RowBox[{"FrameStyle", " ", "->", " ", 
          RowBox[{"GrayLevel", "[", "0.9", "]"}]}], ",", " ", 
         RowBox[{"RoundingRadius", " ", "->", " ", "16"}]}], "]"}], ",", "\n",
        "   ", 
       RowBox[{"ImageResolution", " ", "->", " ", "144"}], ",", " ", 
       RowBox[{"Background", " ", "->", " ", "None"}]}], "]"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "520"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",ExpressionUUID->"30bedf1f-bac3-47d6-bf80-ecedda9d4023"],

